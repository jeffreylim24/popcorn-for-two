# Copy to backend/.env (gitignored) and fill in. Never commit real values.
# In production these are Fly secrets: fly secrets import --stage < backend/.env

# Cloudflare TURN key ID and API token (free tier is enough):
# https://developers.cloudflare.com/realtime/turn/
# Required: the server refuses to start without both, unless LOAD_TEST=1.
TURN_KEY_ID=
TURN_KEY_API=

# Optional. 1 = load-test mode: fake TURN, per-IP limits off, no TURN keys
# needed. Refused on the production app. Don't put it in the file you
# import into Fly secrets.
# LOAD_TEST=1

# FLY_APP_NAME and FLY_MACHINE_ID are set by Fly on every machine. Leave
# them out locally: the server then uses the machine ID "local".
